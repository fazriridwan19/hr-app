# Application
APP_PORT=3001
APP_ENV=development
APP_NAME=service-attendance

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_DATABASE=db_attendance
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (must be the same secret as service-employee)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=hr:

# BullMQ
BULLMQ_REDIS_HOST=localhost
BULLMQ_REDIS_PORT=6379
BULLMQ_REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookie
COOKIE_SECRET=your-cookie-secret-change-in-production

# File Upload
UPLOAD_DIR=uploads/attendance
MAX_FILE_SIZE=5242880
